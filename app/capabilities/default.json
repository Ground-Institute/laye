{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What laye's page may ask of the app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "deep-link:default",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "sheet:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://laye.ground.institute/*" },
        { "url": "https://api.q.sbvh.nl/*" }
      ]
    }
  ]
}
