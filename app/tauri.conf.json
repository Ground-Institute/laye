{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "laye",
  "version": "0.1.0",
  "identifier": "laye.ground.institute",
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "laye"
          ]
        }
      ],
      "desktop": {
        "schemes": [
          "laye"
        ]
      }
    }
  },
  "build": {
    "beforeBuildCommand": "./scene.sh",
    "beforeDevCommand": "./scene.sh",
    "frontendDist": "web"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "17.0"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "laye",
        "width": 430,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
