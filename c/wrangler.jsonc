{
  "name": "c",
  // The Rust worker-build makes, as @sentry/cloudflare wraps it.
  "main": "src/sentry.js",
  "compatibility_date": "2026-11-01",
  // @sentry/cloudflare keeps its scope per request in AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm ci --silent && cargo install -q worker-build@=0.8.0 && worker-build --release"
  },
  "durable_objects": {
    "bindings": [{ "name": "PEER", "class_name": "Peer" }]
  },
  // SQLite-backed, the kind of Durable Object the free plan has.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Peer"] }],
  "vars": {
    // Where a browser's laye dials C.
    "LISTEN": "/dns4/c.icy-pine-9304.workers.dev/tcp/443/wss",
    // The topics C carries between the peers connected to it.
    "TOPICS": "laye/through-a-peer"
  },
  "observability": { "enabled": true }
}
